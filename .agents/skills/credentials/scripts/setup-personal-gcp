#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=4

CONFIG_DIR="$HOME/.config/agent-credentials"
ACCOUNT_FILE="$CONFIG_DIR/account"
BILLING_FILE="$CONFIG_DIR/billing-account"
PROJECT_FILE="$CONFIG_DIR/project-id"
SDK_URL="https://cloud.google.com/sdk/docs/install-sdk"
BILLING_ACCOUNTS_URL="https://console.cloud.google.com/billing"
BILLING_CREATE_URL="https://console.cloud.google.com/billing/create"
PROJECT_NAME="Personal Agent Credentials"
PROJECT_LABEL="credential_vault=personal"
WRITER_NAME="personal-secret-writer"
ROLE_ID="personalSecretWriter"
WORK_DIR=""
PERSONAL_ACCOUNT=""
BILLING_ACCOUNT=""
PROJECT_ID=""
PROJECT_CREATED_THIS_RUN=false

die() {
  warn "$1"
  exit 1
}

cleanup() {
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf -- "$WORK_DIR"
  fi
}
trap cleanup EXIT

read_config() {
  local path="$1" value=""
  [[ -f "$path" ]] || return 1
  IFS= read -r value < "$path" || true
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

write_config() {
  local path="$1" value="$2" tmp
  mkdir -p "$CONFIG_DIR"
  chmod 0700 "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/.credential-config.XXXXXX")
  chmod 0600 "$tmp"
  printf '%s\n' "$value" > "$tmp"
  mv "$tmp" "$path"
  chmod 0600 "$path"
}

account_is_authenticated() {
  gcloud --account="$1" auth print-access-token >/dev/null 2>&1
}

billing_is_available() {
  local open
  open=$(gcloud --account="$PERSONAL_ACCOUNT" billing accounts describe "$1" \
    --format='value(open)' 2>/dev/null || true)
  [[ "$open" == "True" || "$open" == "true" ]]
}

load_billing_accounts() {
  local raw id open
  OPEN_BILLING_ACCOUNTS=()
  CLOSED_BILLING_ACCOUNTS=()
  raw=$(gcloud --account="$PERSONAL_ACCOUNT" billing accounts list \
    --format='csv[no-heading](name.basename(),open)')
  while IFS=, read -r id open; do
    [[ -n "$id" ]] || continue
    if [[ "$open" == "True" || "$open" == "true" ]]; then
      OPEN_BILLING_ACCOUNTS+=("$id")
    else
      CLOSED_BILLING_ACCOUNTS+=("$id")
    fi
  done <<< "$raw"
}

billing_is_in_list() {
  local wanted="$1" candidate
  for candidate in "${OPEN_BILLING_ACCOUNTS[@]}"; do
    [[ "$candidate" == "$wanted" ]] && return 0
  done
  return 1
}

choose_billing_account() {
  local candidate display_name
  load_billing_accounts
  while (( ${#OPEN_BILLING_ACCOUNTS[@]} == 0 )); do
    if (( ${#CLOSED_BILLING_ACCOUNTS[@]} )); then
      warn "The billing account visible to $PERSONAL_ACCOUNT is closed."
      step "Open this URL manually in the profile for $PERSONAL_ACCOUNT:"
      say "$BILLING_ACCOUNTS_URL"
      step "Clear the Status: Active filter."
      for candidate in "${CLOSED_BILLING_ACCOUNTS[@]}"; do
        note "Closed billing account: $candidate"
      done
      step "Open the closed account, choose Account Management, then Reopen billing account."
    else
      warn "No billing account is visible to $PERSONAL_ACCOUNT."
      step "Open this URL manually and create a personal billing account:"
      say "$BILLING_CREATE_URL"
    fi
    pause "Press Enter after billing is ready."
    load_billing_accounts
    if (( ${#OPEN_BILLING_ACCOUNTS[@]} == 0 )) && ! confirm "Check again?"; then
      die "Billing is required. Finish it and rerun this wizard."
    fi
  done

  if (( ${#OPEN_BILLING_ACCOUNTS[@]} == 1 )); then
    BILLING_ACCOUNT="${OPEN_BILLING_ACCOUNTS[0]}"
    return
  fi

  say "Open billing accounts visible to the personal account:"
  for candidate in "${OPEN_BILLING_ACCOUNTS[@]}"; do
    display_name=$(gcloud --account="$PERSONAL_ACCOUNT" billing accounts describe "$candidate" \
      --format='value(displayName)' 2>/dev/null || true)
    note "$candidate  $display_name"
  done
  while :; do
    printf '  %sBilling account ID:%s ' "$BOLD" "$RESET"
    read -r BILLING_ACCOUNT || true
    BILLING_ACCOUNT="${BILLING_ACCOUNT#billingAccounts/}"
    billing_is_in_list "$BILLING_ACCOUNT" && return
    warn "Choose one of the listed billing account IDs."
  done
}

project_exists() {
  gcloud --account="$PERSONAL_ACCOUNT" projects describe "$1" \
    --format='value(projectId)' >/dev/null 2>&1
}

project_has_organization() {
  gcloud --account="$PERSONAL_ACCOUNT" projects get-ancestors "$1" \
    --format='value(type)' | grep -Fxq 'organization'
}

discover_personal_project() {
  local raw candidate
  DISCOVERED_PROJECTS=()
  raw=$(gcloud --account="$PERSONAL_ACCOUNT" projects list \
    --filter="(labels.credential_vault=personal OR name=\"$PROJECT_NAME\") AND lifecycleState=ACTIVE" \
    --format='value(projectId)')
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] && DISCOVERED_PROJECTS+=("$candidate")
  done <<< "$raw"

  if (( ${#DISCOVERED_PROJECTS[@]} == 0 )); then
    return 1
  fi
  if (( ${#DISCOVERED_PROJECTS[@]} == 1 )); then
    PROJECT_ID="${DISCOVERED_PROJECTS[0]}"
    return
  fi

  say "Personal credential projects visible to this account:"
  for candidate in "${DISCOVERED_PROJECTS[@]}"; do
    note "$candidate"
  done
  while :; do
    printf '  %sProject ID:%s ' "$BOLD" "$RESET"
    read -r PROJECT_ID || true
    for candidate in "${DISCOVERED_PROJECTS[@]}"; do
      [[ "$candidate" == "$PROJECT_ID" ]] && return
    done
    warn "Choose one of the listed project IDs."
  done
}

load_project_billing() {
  local current_name enabled
  current_name=$(gcloud --account="$PERSONAL_ACCOUNT" billing projects describe "$PROJECT_ID" \
    --format='value(billingAccountName)' 2>/dev/null || true)
  enabled=$(gcloud --account="$PERSONAL_ACCOUNT" billing projects describe "$PROJECT_ID" \
    --format='value(billingEnabled)' 2>/dev/null || true)
  [[ "$enabled" == "True" || "$enabled" == "true" ]] || return 1
  BILLING_ACCOUNT="${current_name#billingAccounts/}"
  [[ -n "$BILLING_ACCOUNT" ]]
}

create_personal_project() {
  local suffix
  suffix=$(openssl rand -hex 6)
  PROJECT_ID="agent-secrets-$suffix"
  say "Creating standalone project $PROJECT_ID."
  gcloud --account="$PERSONAL_ACCOUNT" projects create "$PROJECT_ID" \
    --name="$PROJECT_NAME" --labels="$PROJECT_LABEL" --quiet
  PROJECT_CREATED_THIS_RUN=true
}

link_billing() {
  local current_name current_id enabled
  current_name=$(gcloud --account="$PERSONAL_ACCOUNT" billing projects describe "$PROJECT_ID" \
    --format='value(billingAccountName)' 2>/dev/null || true)
  enabled=$(gcloud --account="$PERSONAL_ACCOUNT" billing projects describe "$PROJECT_ID" \
    --format='value(billingEnabled)' 2>/dev/null || true)
  current_id="${current_name#billingAccounts/}"

  if [[ "$enabled" == "True" && "$current_id" == "$BILLING_ACCOUNT" ]]; then
    return
  fi
  if [[ -n "$current_id" && "$current_id" != "$BILLING_ACCOUNT" && "$PROJECT_CREATED_THIS_RUN" == false ]]; then
    warn "Project $PROJECT_ID currently uses billing account $current_id."
    confirm "Relink it to $BILLING_ACCOUNT?" || die "Billing was not changed. Rerun when ready."
  fi
  gcloud --account="$PERSONAL_ACCOUNT" billing projects link "$PROJECT_ID" \
    --billing-account="$BILLING_ACCOUNT" --quiet >/dev/null
}

configure_audit_logging() {
  local python_path policy_in policy_out
  WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/personal-gcp.XXXXXX")
  chmod 0700 "$WORK_DIR"
  policy_in="$WORK_DIR/policy-in.json"
  policy_out="$WORK_DIR/policy-out.json"
  gcloud --account="$PERSONAL_ACCOUNT" projects get-iam-policy "$PROJECT_ID" \
    --format=json > "$policy_in"

  python_path=$(gcloud info --format='value(basic.python_location)' 2>/dev/null || true)
  if [[ -z "$python_path" || ! -x "$python_path" ]]; then
    python_path=$(command -v python3 || true)
  fi
  [[ -n "$python_path" ]] || die "Python is required to preserve the existing IAM policy."

  "$python_path" - "$policy_in" "$policy_out" <<'PY'
import json
import sys

source, target = sys.argv[1:]
with open(source, encoding="utf-8") as handle:
    policy = json.load(handle)

configs = policy.setdefault("auditConfigs", [])
config = next(
    (item for item in configs if item.get("service") == "secretmanager.googleapis.com"),
    None,
)
if config is None:
    config = {"service": "secretmanager.googleapis.com", "auditLogConfigs": []}
    configs.append(config)

logs = config.setdefault("auditLogConfigs", [])
present = {item.get("logType") for item in logs}
for log_type in ("DATA_READ", "DATA_WRITE"):
    if log_type not in present:
        logs.append({"logType": log_type})

with open(target, "w", encoding="utf-8") as handle:
    json.dump(policy, handle)
PY

  gcloud --account="$PERSONAL_ACCOUNT" projects set-iam-policy "$PROJECT_ID" \
    "$policy_out" --quiet >/dev/null
}

if [[ ! -t 0 || ! -t 1 ]]; then
  printf 'Run this wizard directly in an interactive terminal.\n' >&2
  exit 1
fi

command -v gcloud >/dev/null 2>&1 || {
  printf 'Google Cloud CLI is required. Install it from:\n%s\n' "$SDK_URL" >&2
  exit 1
}
command -v openssl >/dev/null 2>&1 || die "OpenSSL is required to generate a unique project ID."

umask 077
banner "Personal credential vault"

stage "Personal Google account"
PERSONAL_ACCOUNT=$(read_config "$ACCOUNT_FILE" || true)
if [[ -z "$PERSONAL_ACCOUNT" ]]; then
  while [[ -z "$PERSONAL_ACCOUNT" ]]; do
    printf '  %sPersonal Google account email:%s ' "$BOLD" "$RESET"
    read -r PERSONAL_ACCOUNT || true
  done
fi
if account_is_authenticated "$PERSONAL_ACCOUNT"; then
  say "Using the existing gcloud login for $PERSONAL_ACCOUNT."
else
  say "gcloud will print a Google authorization URL. It will not open a browser."
  step "Open that URL manually in the profile for $PERSONAL_ACCOUNT and complete the login."
  gcloud auth login "$PERSONAL_ACCOUNT" --no-launch-browser --no-activate
  account_is_authenticated "$PERSONAL_ACCOUNT" || die "The gcloud login could not be validated."
fi
write_config "$ACCOUNT_FILE" "$PERSONAL_ACCOUNT"
say "Validated $PERSONAL_ACCOUNT."

stage "Existing personal vault"
PROJECT_ID=$(read_config "$PROJECT_FILE" || true)
if [[ -n "$PROJECT_ID" ]] && project_exists "$PROJECT_ID"; then
  if project_has_organization "$PROJECT_ID"; then
    warn "Saved project $PROJECT_ID belongs to an organization. It cannot be the personal vault."
    PROJECT_ID=""
  else
    say "Using standalone project $PROJECT_ID."
  fi
elif [[ -n "$PROJECT_ID" ]]; then
  warn "Saved project $PROJECT_ID is not accessible to $PERSONAL_ACCOUNT."
  PROJECT_ID=""
fi
if [[ -z "$PROJECT_ID" ]]; then
  if discover_personal_project; then
    project_has_organization "$PROJECT_ID" && \
      die "Discovered project $PROJECT_ID belongs to an organization."
    say "Discovered existing personal vault $PROJECT_ID."
  else
    say "No existing personal vault was found. One will be created next."
  fi
fi

stage "Personal project and billing"
if [[ -n "$PROJECT_ID" ]] && load_project_billing; then
  say "Using the billing already linked to $PROJECT_ID."
else
  BILLING_ACCOUNT=$(read_config "$BILLING_FILE" || true)
  if [[ -n "$BILLING_ACCOUNT" ]] && billing_is_available "$BILLING_ACCOUNT"; then
    say "Using personal billing account $BILLING_ACCOUNT."
  else
    [[ -z "$BILLING_ACCOUNT" ]] || warn "Saved billing account $BILLING_ACCOUNT is not available."
    choose_billing_account
    say "Using personal billing account $BILLING_ACCOUNT."
  fi
  if [[ -z "$PROJECT_ID" ]]; then
    create_personal_project
  fi
  if project_has_organization "$PROJECT_ID"; then
    die "Google placed $PROJECT_ID in an organization. It was left untouched; rerun with a personal account."
  fi
  link_billing
fi
write_config "$PROJECT_FILE" "$PROJECT_ID"
write_config "$BILLING_FILE" "$BILLING_ACCOUNT"
say "Validated standalone project $PROJECT_ID with billing enabled."

stage "Secret Manager access"
say "Enabling Secret Manager and creating a keyless, non-destructive writer."
gcloud --account="$PERSONAL_ACCOUNT" services enable \
  secretmanager.googleapis.com \
  iam.googleapis.com \
  iamcredentials.googleapis.com \
  cloudresourcemanager.googleapis.com \
  --project="$PROJECT_ID" --quiet

WRITER_SERVICE_ACCOUNT="$WRITER_NAME@$PROJECT_ID.iam.gserviceaccount.com"
if ! gcloud --account="$PERSONAL_ACCOUNT" iam service-accounts describe \
  "$WRITER_SERVICE_ACCOUNT" --project="$PROJECT_ID" >/dev/null 2>&1; then
  gcloud --account="$PERSONAL_ACCOUNT" iam service-accounts create "$WRITER_NAME" \
    --project="$PROJECT_ID" --display-name="Personal secret writer" --quiet >/dev/null
fi

ROLE_PERMISSIONS="secretmanager.secrets.create,secretmanager.secrets.get,secretmanager.secrets.list,secretmanager.versions.access,secretmanager.versions.add,secretmanager.versions.get,secretmanager.versions.list,serviceusage.services.use"
CUSTOM_ROLE="projects/$PROJECT_ID/roles/$ROLE_ID"
if gcloud --account="$PERSONAL_ACCOUNT" iam roles describe "$ROLE_ID" \
  --project="$PROJECT_ID" >/dev/null 2>&1; then
  gcloud --account="$PERSONAL_ACCOUNT" iam roles update "$ROLE_ID" \
    --project="$PROJECT_ID" --permissions="$ROLE_PERMISSIONS" --stage=GA --quiet >/dev/null
else
  gcloud --account="$PERSONAL_ACCOUNT" iam roles create "$ROLE_ID" \
    --project="$PROJECT_ID" --title="Personal Secret Writer" \
    --description="Create, version, list, and recover personal machine secrets without destructive access." \
    --permissions="$ROLE_PERMISSIONS" --stage=GA --quiet >/dev/null
fi

gcloud --account="$PERSONAL_ACCOUNT" projects add-iam-policy-binding "$PROJECT_ID" \
  --member="serviceAccount:$WRITER_SERVICE_ACCOUNT" --role="$CUSTOM_ROLE" \
  --condition=None --quiet >/dev/null
gcloud --account="$PERSONAL_ACCOUNT" iam service-accounts add-iam-policy-binding \
  "$WRITER_SERVICE_ACCOUNT" --project="$PROJECT_ID" \
  --member="user:$PERSONAL_ACCOUNT" --role=roles/iam.serviceAccountTokenCreator \
  --condition=None --quiet >/dev/null
configure_audit_logging

gcloud --account="$PERSONAL_ACCOUNT" auth print-access-token \
  --impersonate-service-account="$WRITER_SERVICE_ACCOUNT" >/dev/null
gcloud --account="$PERSONAL_ACCOUNT" --project="$PROJECT_ID" \
  --impersonate-service-account="$WRITER_SERVICE_ACCOUNT" secrets list \
  --format='value(name)' >/dev/null

finish
say "Account: $PERSONAL_ACCOUNT"
say "Project: $PROJECT_ID"
say "Billing: $BILLING_ACCOUNT"
say "Writer: $WRITER_SERVICE_ACCOUNT"
say "Saved non-secret routing metadata in $CONFIG_DIR."
say "No service-account key or secret value was created."
say "This machine is ready to use the personal credential vault."
