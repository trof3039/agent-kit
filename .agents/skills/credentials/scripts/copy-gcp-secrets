#!/usr/bin/env bash

set -euo pipefail

CONFIG_DIR="$HOME/.config/agent-credentials"
ACCOUNT_FILE="$CONFIG_DIR/account"
PROJECT_FILE="$CONFIG_DIR/project-id"
WRITER_NAME="personal-secret-writer"
GOOGLE_ACCOUNTS_URL="https://accounts.google.com/"
WORK_DIR=""
SOURCE_ACCOUNT=""
SOURCE_PROJECT=""
TARGET_ACCOUNT=""
TARGET_PROJECT=""
TARGET_WRITER=""
SELECTORS=()
SOURCE_SECRETS=()
TARGET_SECRETS=()
SELECTED_SECRETS=()
COPIED=0
UPDATED=0
UNCHANGED=0

usage() {
  cat <<'EOF'
Usage: copy-gcp-secrets SOURCE_ACCOUNT SOURCE_PROJECT SELECTOR...

Copy matching Secret Manager payloads into the personal credential vault.
Selectors are exact secret names or Bash-style globs such as 'provider-*'.

The destination account and project come from:
  ~/.config/agent-credentials/account
  ~/.config/agent-credentials/project-id
EOF
}

die() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

cleanup() {
  local exit_code=$?
  trap - EXIT
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    find "$WORK_DIR" -depth -delete 2>/dev/null || true
  fi
  exit "$exit_code"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

read_config() {
  local path="$1" value=""
  [[ -f "$path" ]] || return 1
  IFS= read -r value < "$path" || true
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

contains_name() {
  local wanted="$1" candidate
  shift
  for candidate in "$@"; do
    [[ "$candidate" == "$wanted" ]] && return 0
  done
  return 1
}

source_account_is_authenticated() {
  gcloud --account="$SOURCE_ACCOUNT" auth print-access-token >/dev/null 2>&1
}

ensure_source_login() {
  if source_account_is_authenticated; then
    return
  fi

  printf 'Google account login is required for %s.\n' "$SOURCE_ACCOUNT"
  printf 'Provider: %s\n' "$GOOGLE_ACCOUNTS_URL"
  printf 'gcloud will print an authorization URL and will not open it automatically.\n'
  [[ -t 0 && -t 1 ]] || die "Run this command directly in an interactive terminal."
  gcloud auth login "$SOURCE_ACCOUNT" --no-launch-browser --no-activate
  source_account_is_authenticated || die "The source gcloud login could not be validated."
}

target_command() {
  gcloud --account="$TARGET_ACCOUNT" --project="$TARGET_PROJECT" \
    --impersonate-service-account="$TARGET_WRITER" "$@"
}

validate_target() {
  local billing_enabled

  if ! gcloud --account="$TARGET_ACCOUNT" auth print-access-token >/dev/null 2>&1; then
    die "Personal vault login is unavailable. Rerun ./.agents/skills/credentials/scripts/setup-personal-gcp."
  fi
  if ! gcloud --account="$TARGET_ACCOUNT" --project="$TARGET_PROJECT" auth print-access-token \
    --impersonate-service-account="$TARGET_WRITER" >/dev/null 2>&1; then
    die "Personal vault writer is unavailable. Rerun ./.agents/skills/credentials/scripts/setup-personal-gcp."
  fi

  billing_enabled=$(gcloud --account="$TARGET_ACCOUNT" billing projects describe "$TARGET_PROJECT" \
    --format='value(billingEnabled)' 2>/dev/null || true)
  [[ "$billing_enabled" == "True" || "$billing_enabled" == "true" ]] || \
    die "Billing is not enabled for the saved personal vault $TARGET_PROJECT."
}

load_source_secrets() {
  local raw line
  if ! raw=$(gcloud --account="$SOURCE_ACCOUNT" --project="$SOURCE_PROJECT" secrets list \
    --format='value(name.basename())' 2>/dev/null); then
    die "Cannot list Secret Manager metadata in source project $SOURCE_PROJECT."
  fi
  SOURCE_SECRETS=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && SOURCE_SECRETS+=("$line")
  done <<< "$raw"
  return 0
}

load_target_secrets() {
  local raw line
  if ! raw=$(target_command secrets list --format='value(name.basename())' 2>/dev/null); then
    die "Cannot list Secret Manager metadata in personal vault $TARGET_PROJECT."
  fi
  TARGET_SECRETS=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && TARGET_SECRETS+=("$line")
  done <<< "$raw"
  return 0
}

select_source_secrets() {
  local selector secret_name matched
  for selector in "${SELECTORS[@]}"; do
    [[ -n "$selector" ]] || die "A selector cannot be empty."
    matched=false
    for secret_name in ${SOURCE_SECRETS[@]+"${SOURCE_SECRETS[@]}"}; do
      # The unquoted right-hand side is intentionally interpreted as a glob.
      if [[ "$secret_name" == $selector ]]; then
        matched=true
        if ! contains_name "$secret_name" ${SELECTED_SECRETS[@]+"${SELECTED_SECRETS[@]}"}; then
          SELECTED_SECRETS+=("$secret_name")
        fi
      fi
    done
    [[ "$matched" == true ]] || die "Selector '$selector' matched no source secrets."
  done
  (( ${#SELECTED_SECRETS[@]} > 0 )) || die "No source secrets were selected."
}

source_version_is_enabled() {
  local secret_name="$1" state
  state=$(gcloud --account="$SOURCE_ACCOUNT" --project="$SOURCE_PROJECT" \
    secrets versions describe latest --secret="$secret_name" \
    --format='value(state)' 2>/dev/null || true)
  [[ "$state" == "ENABLED" ]]
}

download_source() {
  local secret_name="$1" output_file="$2"
  gcloud --account="$SOURCE_ACCOUNT" --project="$SOURCE_PROJECT" \
    secrets versions access latest --secret="$secret_name" \
    --out-file="$output_file" >/dev/null 2>&1
  chmod 0600 "$output_file"
}

download_target() {
  local secret_name="$1" output_file="$2" state
  state=$(target_command secrets versions describe latest --secret="$secret_name" \
    --format='value(state)' 2>/dev/null || true)
  [[ "$state" == "ENABLED" ]] || return 1
  target_command secrets versions access latest --secret="$secret_name" \
    --out-file="$output_file" >/dev/null 2>&1 || return 1
  chmod 0600 "$output_file"
}

create_target_secret() {
  local secret_name="$1"
  target_command secrets create "$secret_name" --replication-policy=automatic \
    --labels=managed_by=credential_workflow,owner=personal --quiet >/dev/null 2>&1
  TARGET_SECRETS+=("$secret_name")
}

add_target_version() {
  local secret_name="$1" source_file="$2"
  target_command secrets versions add "$secret_name" \
    --data-file="$source_file" --quiet >/dev/null 2>&1
}

copy_secret() {
  local secret_name="$1" index="$2"
  local source_file="$WORK_DIR/source-$index" target_file="$WORK_DIR/target-$index"
  local existed=false

  source_version_is_enabled "$secret_name" || \
    die "Source secret $secret_name has no enabled latest version."
  download_source "$secret_name" "$source_file" || \
    die "Could not read source secret $secret_name."

  if contains_name "$secret_name" ${TARGET_SECRETS[@]+"${TARGET_SECRETS[@]}"}; then
    existed=true
    if download_target "$secret_name" "$target_file" && cmp -s "$source_file" "$target_file"; then
      printf 'already copied  %s\n' "$secret_name"
      UNCHANGED=$((UNCHANGED + 1))
      return
    fi
  else
    create_target_secret "$secret_name" || die "Could not create target secret $secret_name."
  fi

  add_target_version "$secret_name" "$source_file" || \
    die "Could not add a target version for $secret_name."
  : > "$target_file"
  download_target "$secret_name" "$target_file" || \
    die "Could not validate the target version for $secret_name."
  cmp -s "$source_file" "$target_file" || \
    die "Byte validation failed for $secret_name. The source was left untouched."

  if [[ "$existed" == true ]]; then
    printf 'updated         %s\n' "$secret_name"
    UPDATED=$((UPDATED + 1))
  else
    printf 'copied          %s\n' "$secret_name"
    COPIED=$((COPIED + 1))
  fi
}

if (( $# < 3 )); then
  usage >&2
  exit 2
fi

SOURCE_ACCOUNT="$1"
SOURCE_PROJECT="$2"
shift 2
SELECTORS=("$@")

command -v gcloud >/dev/null 2>&1 || die "Google Cloud CLI is required: https://cloud.google.com/sdk/docs/install-sdk"
GCLOUD_BIN=$(command -v gcloud)
gcloud() {
  env \
    -u CLOUDSDK_AUTH_ACCESS_TOKEN \
    -u CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE \
    -u GOOGLE_APPLICATION_CREDENTIALS \
    CLOUDSDK_CONFIG="$HOME/.config/gcloud" \
    "$GCLOUD_BIN" "$@"
}
command -v cmp >/dev/null 2>&1 || die "cmp is required."

TARGET_ACCOUNT=$(read_config "$ACCOUNT_FILE" || true)
TARGET_PROJECT=$(read_config "$PROJECT_FILE" || true)
[[ -n "$TARGET_ACCOUNT" && -n "$TARGET_PROJECT" ]] || \
  die "Personal vault setup is incomplete. Run ./.agents/skills/credentials/scripts/setup-personal-gcp first."
[[ "$SOURCE_PROJECT" != "$TARGET_PROJECT" ]] || die "Source and target projects are the same."
TARGET_WRITER="$WRITER_NAME@$TARGET_PROJECT.iam.gserviceaccount.com"

umask 077
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/copy-gcp-secrets.XXXXXX")
chmod 0700 "$WORK_DIR"

ensure_source_login
validate_target
load_source_secrets
load_target_secrets
select_source_secrets

printf 'Source: %s (%s)\n' "$SOURCE_PROJECT" "$SOURCE_ACCOUNT"
printf 'Target: %s (%s)\n' "$TARGET_PROJECT" "$TARGET_ACCOUNT"
printf 'Selected %s secret(s). Values will not be displayed.\n\n' "${#SELECTED_SECRETS[@]}"

INDEX=0
for SECRET_NAME in "${SELECTED_SECRETS[@]}"; do
  INDEX=$((INDEX + 1))
  copy_secret "$SECRET_NAME" "$INDEX"
done

printf '\nCopy complete: %s copied, %s updated, %s already identical.\n' \
  "$COPIED" "$UPDATED" "$UNCHANGED"
printf 'Every copied value was byte-validated. Source secrets were not changed or deleted.\n'
