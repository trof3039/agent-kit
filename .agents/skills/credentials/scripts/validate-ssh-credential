#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: validate-ssh-credential --identity PATH --user USER --host HOST [--port PORT]' \
    '' \
    'Proves one SSH private key against one literal host without config, agent,' \
    'default-key, password, keyboard-interactive, GSSAPI, or host-based fallback.'
}

die() {
  printf 'validate-ssh-credential: %s\n' "$1" >&2
  exit 2
}

identity=''
user=''
host=''
port='22'

while (( $# > 0 )); do
  case "$1" in
    --identity)
      (( $# >= 2 )) || die 'missing value for --identity'
      identity="$2"
      shift 2
      ;;
    --user)
      (( $# >= 2 )) || die 'missing value for --user'
      user="$2"
      shift 2
      ;;
    --host)
      (( $# >= 2 )) || die 'missing value for --host'
      host="$2"
      shift 2
      ;;
    --port)
      (( $# >= 2 )) || die 'missing value for --port'
      port="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unexpected argument: $1"
      ;;
  esac
done

[[ -n "$identity" ]] || die '--identity is required'
[[ -n "$user" ]] || die '--user is required'
[[ -n "$host" ]] || die '--host is required'
[[ "$host" == *.* || "$host" == *:* ]] || \
  die '--host must be a literal IP address or DNS name, not an SSH alias'
[[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || die '--port is invalid'
[[ -f "$identity" ]] || die 'identity file is missing'

identity_directory=$(cd "$(dirname "$identity")" && pwd -P)
identity="$identity_directory/$(basename "$identity")"
ssh_bin="${CREDENTIAL_SSH_BIN:-ssh}"
target="$user@$host"

ssh_options=(
  -F /dev/null
  -o IdentityAgent=none
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
  -o PreferredAuthentications=publickey
  -o PubkeyAuthentication=yes
  -o GSSAPIAuthentication=no
  -o HostbasedAuthentication=no
  -o NumberOfPasswordPrompts=0
  -o ConnectTimeout=8
  -o ConnectionAttempts=1
  -o ClearAllForwardings=yes
  -o CanonicalizeHostname=no
  -o StrictHostKeyChecking=accept-new
  -p "$port"
  -i "$identity"
)

unset SSH_AUTH_SOCK SSH_AGENT_PID

effective=$(
  "$ssh_bin" "${ssh_options[@]}" -G -- "$target" 2>/dev/null
) || die 'could not resolve isolated SSH configuration'

effective_value() {
  printf '%s\n' "$effective" | awk -v key="$1" '$1 == key { $1 = ""; sub(/^ /, ""); print }'
}

identity_files=$(effective_value identityfile)
[[ "$identity_files" == "$identity" ]] || die 'effective SSH configuration contains another identity'
[[ "$(effective_value user)" == "$user" ]] || die 'effective SSH user differs from the declared user'
[[ "$(effective_value hostname)" == "$host" ]] || die 'effective SSH host differs from the declared host'
[[ "$(effective_value identityagent)" == 'none' ]] || die 'SSH agent fallback is active'
[[ "$(effective_value identitiesonly)" == 'yes' ]] || die 'implicit identity fallback is active'
[[ "$(effective_value batchmode)" == 'yes' ]] || die 'interactive authentication is active'
[[ "$(effective_value passwordauthentication)" == 'no' ]] || die 'password fallback is active'
[[ "$(effective_value kbdinteractiveauthentication)" == 'no' ]] || \
  die 'keyboard-interactive fallback is active'
[[ "$(effective_value preferredauthentications)" == 'publickey' ]] || \
  die 'a non-public-key authentication method is active'
[[ "$(effective_value gssapiauthentication)" == 'no' ]] || die 'GSSAPI fallback is active'
[[ "$(effective_value hostbasedauthentication)" == 'no' ]] || \
  die 'host-based fallback is active'

if ! "$ssh_bin" "${ssh_options[@]}" -- "$target" true >/dev/null 2>/dev/null; then
  printf 'validate-ssh-credential: declared identity was rejected by %s\n' "$target" >&2
  exit 1
fi
printf 'ssh_credential=valid user=%s host=%s port=%s\n' "$user" "$host" "$port"
